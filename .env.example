# Copiá a .env (en la misma carpeta) y completá con tus valores reales.
#   cp .env.example .env
# .env está en .gitignore: nunca se sube al repo.

GROQ_API_KEY=tu_key_de_groq
PEXELS_API_KEY=tu_key_de_pexels

# Elegí un token largo y random (ej: openssl rand -hex 32). Es el candado
# de la webapp: sin este token en el header X-Api-Token, nadie puede usarla.
WEBAPP_TOKEN=elegi_un_token_largo_y_random

# Hostname público para que Caddy consiga el certificado HTTPS automático.
# Si no tenés dominio propio, usá el truco de nip.io con la IP pública de tu VM:
# IP 123.45.67.89 -> DOMINIO=123-45-67-89.nip.io (ver docs/deploy-oracle-cloud-free-tier.md)
DOMINIO=tu-dominio-o-ip.nip.io
