__pycache__/
*.pyc
.venv/
venv/

# Config real con API keys — usar config/settings.example.yaml y .env.example como plantillas
config/settings.yaml
.env

# Contenido generado en cada corrida (no es código del proyecto)
logs/*.log
logs/jobs_estado.json
output/*.txt
output/*.srt
output/audio_limpio.wav
output_videos/*
input_audio/*
history/*.json
assets/broll_temp/*
assets/media_usuario/*
assets/overlays_usuario/*

!logs/.gitkeep
!output/.gitkeep
!output_videos/.gitkeep
!input_audio/.gitkeep
!history/.gitkeep
!assets/broll_temp/.gitkeep
!assets/media_usuario/.gitkeep
!assets/overlays_usuario/.gitkeep

# Música que cada quien deja en assets/musica/ (archivos con su propia
# licencia, no son parte del código) — se ignoran menos el LEEME
assets/musica/*
!assets/musica/.gitkeep
!assets/musica/LEEME.md
